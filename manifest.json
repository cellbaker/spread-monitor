{
    "manifest_version":  3,
    "name":  "Spread Monitor — 10 бирж | @cellbaker",
    "version":  "1.1.0",
    "description":  "Спред между биржами и справедливая цена на фьючерсах 10 бирж. Created by @cellbaker",
    "action":  {
                   "default_popup":  "popup.html",
                   "default_title":  "Spread Monitor",
                   "default_icon":  {
                                        "16":  "icons/icon16.png",
                                        "48":  "icons/icon48.png",
                                        "128":  "icons/icon128.png"
                                    }
               },
    "background":  {
                       "service_worker":  "background.js",
                       "type":  "module"
                   },
    "permissions":  [
                        "storage",
                        "alarms"
                    ],
    "host_permissions":  [
                             "https://contract.mexc.com/*",
                             "https://api.mexc.com/*",
                             "https://futures.ourbit.com/*",
                             "https://api.bybit.com/*",
                             "https://fapi.binance.com/*",
                             "https://www.binance.com/*",
                             "https://api.binance.com/*",
                             "https://fapi.asterdex.com/*",
                             "https://api.gateio.ws/*",
                             "https://www.okx.com/*",
                             "https://api-futures.kucoin.com/*",
                             "https://api.kucoin.com/*",
                             "https://api.bitget.com/*",
                             "https://open-api.bingx.com/*",
                             "https://api.coingecko.com/*"
                         ],
    "content_scripts":  [
                            {
                                "matches":  [
                                                "https://*.mexc.com/*",
                                                "https://*.ourbit.com/*",
                                                "https://*.bybit.com/*",
                                                "https://*.binance.com/*",
                                                "https://*.gate.io/*",
                                                "https://*.gate.com/*",
                                                "https://*.okx.com/*",
                                                "https://*.asterdex.com/*",
                                                "https://*.kucoin.com/*",
                                                "https://*.bitget.com/*",
                                                "https://*.bingx.com/*"
                                            ],
                                "js":  [
                                           "content.js"
                                       ],
                                "css":  [
                                            "content.css"
                                        ],
                                "run_at":  "document_idle"
                            }
                        ],
    "web_accessible_resources":  [
                                     {
                                         "resources":  [
                                                           "icons/ex/*.png"
                                                       ],
                                         "matches":  [
                                                         "https://*.mexc.com/*",
                                                         "https://*.ourbit.com/*",
                                                         "https://*.bybit.com/*",
                                                         "https://*.binance.com/*",
                                                         "https://*.gate.io/*",
                                                         "https://*.gate.com/*",
                                                         "https://*.okx.com/*",
                                                         "https://*.asterdex.com/*",
                                                         "https://*.kucoin.com/*",
                                                         "https://*.bitget.com/*",
                                                         "https://*.bingx.com/*"
                                                     ]
                                     }
                                 ],
    "icons":  {
                  "16":  "icons/icon16.png",
                  "48":  "icons/icon48.png",
                  "128":  "icons/icon128.png"
              }
}
